{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/indoor_data_model/scenario_model.schema.json",
  "title": "Indoor Data Model - scenario_model.json",
  "description": "Scenario overlay for EvacEngine. Spatial truth remains in indoor_model.json; this file contains population, dynamic overlays, routing, physics and output configuration.",
  "type": "object",
  "required": [
    "scenarioId",
    "metadata",
    "indoorModelRef",
    "population",
    "routing",
    "physics",
    "simulationConfig"
  ],
  "additionalProperties": false,
  "properties": {
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "scenarioName": {
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "indoorModelRef": {
      "$ref": "#/$defs/IndoorModelRef"
    },
    "catalogs": {
      "$ref": "#/$defs/Catalogs"
    },
    "population": {
      "$ref": "#/$defs/Population"
    },
    "beaconSystem": {
      "$ref": "#/$defs/BeaconSystem"
    },
    "hazards": {
      "$ref": "#/$defs/HazardSystem"
    },
    "environmentOverrides": {
      "$ref": "#/$defs/EnvironmentOverrides"
    },
    "routing": {
      "$ref": "#/$defs/Routing"
    },
    "physics": {
      "$ref": "#/$defs/Physics"
    },
    "scheduledEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ScheduledEvent"
      }
    },
    "simulationConfig": {
      "$ref": "#/$defs/SimulationConfig"
    },
    "experiments": {
      "$ref": "#/$defs/Experiments"
    },
    "outputs": {
      "$ref": "#/$defs/Outputs"
    },
    "scenarioDataModel": {
      "$ref": "#/$defs/ScenarioDataModelInfo"
    }
  },
  "$defs": {
    "Metadata": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "modifiedAt": {
          "type": "string",
          "format": "date-time"
        },
        "author": {
          "type": "string"
        },
        "generator": {
          "type": "string"
        }
      }
    },
    "IndoorModelRef": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "indoorModelId": {
          "type": "string"
        },
        "schemaRef": {
          "type": "string"
        },
        "checksum": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Catalogs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mobilityCatalogRef": {
          "type": "string"
        },
        "hazardCatalogRef": {
          "type": "string"
        },
        "behaviorCatalogRef": {
          "type": "string"
        }
      }
    },
    "Population": {
      "type": "object",
      "required": [
        "mobilityProfiles",
        "agentGroups",
        "agentSpawns"
      ],
      "additionalProperties": false,
      "properties": {
        "mobilityProfiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/MobilityProfile"
          }
        },
        "agentGroups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentGroup"
          }
        },
        "agentSpawns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AgentSpawn"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Agent"
          }
        }
      }
    },
    "MobilityProfile": {
      "type": "object",
      "required": [
        "profileId",
        "locomotionTypes",
        "baseSpeedMps"
      ],
      "additionalProperties": false,
      "properties": {
        "profileId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "locomotionTypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "Walking",
              "Rolling",
              "Flying",
              "Unspecified"
            ]
          }
        },
        "baseSpeedMps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bodyRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "personalRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "canUseStairs": {
          "type": "boolean"
        },
        "canUseRamps": {
          "type": "boolean"
        },
        "canUseElevators": {
          "type": "boolean"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "AgentGroup": {
      "type": "object",
      "required": [
        "groupId",
        "count",
        "mobilityProfileRef",
        "spawnRef"
      ],
      "additionalProperties": false,
      "properties": {
        "groupId": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "mobilityProfileRef": {
          "type": "string"
        },
        "spawnRef": {
          "type": "string"
        },
        "distribution": {
          "enum": [
            "fixed",
            "random_within_space",
            "random_near_point"
          ]
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "AgentSpawn": {
      "type": "object",
      "required": [
        "spawnId",
        "levelRef",
        "position"
      ],
      "anyOf": [
        {
          "required": [
            "cellSpaceRef"
          ]
        },
        {
          "required": [
            "nodeRef"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "spawnId": {
          "type": "string"
        },
        "levelRef": {
          "type": "string"
        },
        "cellSpaceRef": {
          "type": "string"
        },
        "nodeRef": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "capacity": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string"
        }
      }
    },
    "Agent": {
      "type": "object",
      "required": [
        "agentId",
        "mobilityProfileRef",
        "initialPosition"
      ],
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "type": "string"
        },
        "groupRef": {
          "type": "string"
        },
        "mobilityProfileRef": {
          "type": "string"
        },
        "initialPosition": {
          "$ref": "#/$defs/Point"
        },
        "initialCellSpaceRef": {
          "type": "string"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "BeaconSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "fusion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "conservative_min",
                "weighted_mean"
              ]
            },
            "defaultRadiusM": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "beacons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Beacon"
          }
        }
      }
    },
    "Beacon": {
      "type": "object",
      "required": [
        "beaconId",
        "levelRef",
        "position",
        "influence"
      ],
      "additionalProperties": false,
      "properties": {
        "beaconId": {
          "type": "string"
        },
        "levelRef": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Point"
        },
        "attachedTo": {
          "$ref": "#/$defs/EntityRef"
        },
        "sensorTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "influence": {
          "$ref": "#/$defs/Influence"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "HazardSystem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Hazard"
          }
        }
      }
    },
    "Hazard": {
      "type": "object",
      "required": [
        "hazardId",
        "hazardType",
        "levelRef",
        "activation"
      ],
      "anyOf": [
        {
          "required": [
            "initialPosition"
          ]
        },
        {
          "required": [
            "initialArea"
          ]
        },
        {
          "required": [
            "affects"
          ]
        }
      ],
      "additionalProperties": false,
      "properties": {
        "hazardId": {
          "type": "string"
        },
        "hazardType": {
          "enum": [
            "fire",
            "smoke",
            "blocked_area",
            "structural_risk",
            "custom"
          ]
        },
        "levelRef": {
          "type": "string"
        },
        "initialPosition": {
          "$ref": "#/$defs/Point"
        },
        "initialArea": {
          "$ref": "#/$defs/Polygon"
        },
        "activation": {
          "$ref": "#/$defs/Activation"
        },
        "growthModel": {
          "$ref": "#/$defs/GrowthModel"
        },
        "affects": {
          "$ref": "#/$defs/Affects"
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "severity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "Routing": {
      "type": "object",
      "required": [
        "algorithm",
        "costPolicy",
        "destination"
      ],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "dijkstra",
            "astar",
            "floyd_warshall",
            "yen_ksp",
            "robust_agility"
          ]
        },
        "costPolicy": {
          "enum": [
            "minimum_travel_time"
          ]
        },
        "destination": {
          "$ref": "#/$defs/Destination"
        },
        "deriveConnectivityFromEdges": {
          "type": "boolean"
        },
        "useDynamicWeights": {
          "type": "boolean"
        },
        "useBeaconRisk": {
          "type": "boolean"
        },
        "beaconBlockThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "useHazardRisk": {
          "type": "boolean"
        },
        "useCongestion": {
          "type": "boolean"
        },
        "riskCostModel": {
          "enum": [
            "legacy_additive",
            "multiplicative_beta",
            "linear_time_risk"
          ]
        },
        "riskEndpointPolicy": {
          "enum": [
            "target",
            "source",
            "mean",
            "min",
            "max"
          ]
        },
        "riskEdgePrecedence": {
          "type": "boolean"
        },
        "riskAggregation": {
          "enum": [
            "sum",
            "max",
            "mean"
          ]
        },
        "riskAlpha": {
          "type": "number",
          "minimum": 0
        },
        "hazardBeta": {
          "type": "number",
          "minimum": 0
        },
        "beaconBeta": {
          "type": "number",
          "minimum": 0
        },
        "riskUnitCost": {
          "type": "number",
          "minimum": 0
        },
        "replanPolicy": {
          "enum": [
            "never",
            "blocked_only",
            "on_blocked_or_interval",
            "every_step"
          ]
        },
        "replanIntervalSteps": {
          "type": "integer",
          "minimum": 1
        },
        "noRouteRetryIntervalSteps": {
          "type": "integer",
          "minimum": 1
        },
        "routeRecommendation": {
          "$ref": "#/$defs/RouteRecommendation"
        }
      }
    },
    "RouteRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routeSelection": {
          "enum": [
            "lowest_cost",
            "highest_robustness",
            "highest_agility",
            "robust_agility",
            "cer_weighted",
            "cer_agility_yen"
          ]
        },
        "centralityType": {
          "enum": [
            "legacy",
            "rerouting"
          ]
        },
        "kShortestPaths": {
          "type": "integer",
          "minimum": 1
        },
        "candidateCostTolerance": {
          "type": "number",
          "minimum": 0
        },
        "robustnessTolerance": {
          "type": "number",
          "minimum": 0
        },
        "centralityTolerance": {
          "type": "number",
          "minimum": 0
        },
        "centralityMaxPaths": {
          "type": "integer",
          "minimum": 1
        },
        "centralityMaxOverlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "costWeight": {
          "type": "number",
          "minimum": 0
        },
        "robustnessWeight": {
          "type": "number",
          "minimum": 0
        },
        "agilityWeight": {
          "type": "number",
          "minimum": 0
        },
        "agilityAggregation": {
          "enum": [
            "mean",
            "geometric"
          ]
        },
        "reroutingEnabled": {
          "type": "boolean"
        },
        "reroutingFailureProfiles": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "reroutingMaxDepth": {
          "type": "integer",
          "minimum": 1
        },
        "reroutingMaxK": {
          "type": "integer",
          "minimum": 1
        },
        "reroutingCostTolerance": {
          "type": "number",
          "minimum": 0
        },
        "reroutingFailureUnit": {
          "enum": [
            "arc",
            "undirected_pair",
            "resource",
            "cell"
          ]
        },
        "reroutingDistinctnessPolicy": {
          "enum": [
            "exact",
            "overlap"
          ]
        },
        "reroutingMaxCombinations": {
          "type": "integer",
          "minimum": 1
        },
        "reroutingMaxRuntimeMs": {
          "type": "integer",
          "minimum": 1
        },
        "reroutingUseStructuralPrecompute": {
          "type": "boolean"
        },
        "reroutingStoreRoutes": {
          "type": "boolean"
        },
        "reroutingMaxOverlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reroutingProfileWeights": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "Destination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "explicit_cells",
            "nearest_reachable_anchor"
          ]
        },
        "cellSpaceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "category": {
          "type": "string"
        },
        "function": {
          "type": "string"
        }
      }
    },
    "Physics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bodyRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "personalRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "wallRepulsion": {
          "type": "number",
          "minimum": 0
        },
        "socialRepulsion": {
          "type": "number",
          "minimum": 0
        },
        "proximitySlowdownMemoryS": {
          "type": "number",
          "minimum": 0
        },
        "spawnMinSpacingM": {
          "type": "number",
          "minimum": 0
        },
        "bodySeparationSlackM": {
          "type": "number",
          "minimum": 0
        },
        "doorQueueClearanceM": {
          "type": "number",
          "minimum": 0
        },
        "doorQueueCorrectionMaxM": {
          "type": "number",
          "minimum": 0
        },
        "transferQueueActivationM": {
          "type": "number",
          "minimum": 0
        },
        "queueCorrectionSpeedScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "transferCenterPull": {
          "type": "number",
          "minimum": 0
        },
        "linearTransferCenterPull": {
          "type": "number",
          "minimum": 0
        },
        "stairSpeedFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rampSpeedFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "elevatorSpeedFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "edgeAccelerationDelayS": {
          "type": "number",
          "minimum": 0
        },
        "doorTraversalPenaltyS": {
          "type": "number",
          "minimum": 0
        },
        "transferTraversalPenaltyS": {
          "type": "number",
          "minimum": 0
        },
        "linearTransferTraversalPenaltyS": {
          "type": "number",
          "minimum": 0
        },
        "virtualBoundaryTraversalPenaltyS": {
          "type": "number",
          "minimum": 0
        },
        "elevatorTraversalPenaltyS": {
          "type": "number",
          "minimum": 0
        },
        "linearTransferFlowMode": {
          "enum": [
            "single_file",
            "platoon"
          ]
        },
        "linearTransferQueueSpacingM": {
          "type": "number",
          "minimum": 0
        },
        "stairCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "rampCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "maxAccelerationMps2": {
          "type": "number",
          "minimum": 0
        },
        "velocityInertia": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.85
        },
        "maxTurnRateRadS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "lineOfSightBlend": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "lineOfSightDistanceM": {
          "type": "number",
          "minimum": 0
        },
        "lineOfSightMaxNodes": {
          "type": "integer",
          "minimum": 2
        },
        "nearLineOfSightBlend": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        },
        "doorCenterBias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "doorEntryInsetM": {
          "type": "number",
          "minimum": 0
        },
        "doorExitInsetM": {
          "type": "number",
          "minimum": 0
        },
        "virtualBoundaryExitInsetM": {
          "type": "number",
          "minimum": 0
        },
        "virtualBoundaryEntryInsetM": {
          "type": "number",
          "minimum": 0
        },
        "virtualBoundaryArrivalRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "linearTransferExitInsetM": {
          "type": "number",
          "minimum": 0
        },
        "doorApproachLookaheadM": {
          "type": "number",
          "minimum": 0
        },
        "linearTransferLookaheadM": {
          "type": "number",
          "minimum": 0
        },
        "doorPreEntryDistanceM": {
          "type": "number",
          "minimum": 0
        },
        "linearTransferPreEntryDistanceM": {
          "type": "number",
          "minimum": 0
        },
        "doorApproachLateralToleranceM": {
          "type": "number",
          "minimum": 0
        },
        "wallRepulsionDistanceM": {
          "type": "number",
          "minimum": 0
        },
        "wallClearanceM": {
          "type": "number",
          "minimum": 0
        },
        "transferWallClearanceM": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "SimulationConfig": {
      "type": "object",
      "required": [
        "timeStepS",
        "maxSteps"
      ],
      "additionalProperties": false,
      "properties": {
        "timeStepS": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxSteps": {
          "type": "integer",
          "minimum": 1
        },
        "randomSeed": {
          "type": "integer"
        },
        "enabledOverlays": {
          "type": "array",
          "items": {
            "enum": [
              "population",
              "beacons",
              "hazards"
            ]
          }
        }
      }
    },
    "EnvironmentOverrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cellOverrides": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "edgeOverrides": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "ScheduledEvent": {
      "type": "object",
      "required": [
        "eventId",
        "step",
        "eventType"
      ],
      "additionalProperties": true,
      "properties": {
        "eventId": {
          "type": "string"
        },
        "step": {
          "type": "integer",
          "minimum": 0
        },
        "eventType": {
          "type": "string"
        }
      }
    },
    "Experiments": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replications": {
          "type": "integer",
          "minimum": 1
        },
        "parameterSweep": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "routingPresets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RoutingPreset"
          }
        }
      }
    },
    "RoutingPreset": {
      "type": "object",
      "required": [
        "presetId",
        "routing"
      ],
      "additionalProperties": false,
      "properties": {
        "presetId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "routing": {
          "$ref": "#/$defs/RoutingPresetPatch"
        }
      }
    },
    "RoutingPresetPatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "dijkstra",
            "astar",
            "floyd_warshall",
            "yen_ksp",
            "robust_agility"
          ]
        },
        "costPolicy": {
          "enum": [
            "minimum_travel_time"
          ]
        },
        "useDynamicWeights": {
          "type": "boolean"
        },
        "useBeaconRisk": {
          "type": "boolean"
        },
        "beaconBlockThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "useHazardRisk": {
          "type": "boolean"
        },
        "useCongestion": {
          "type": "boolean"
        },
        "riskCostModel": {
          "enum": [
            "legacy_additive",
            "multiplicative_beta",
            "linear_time_risk"
          ]
        },
        "riskEndpointPolicy": {
          "enum": [
            "target",
            "source",
            "mean",
            "min",
            "max"
          ]
        },
        "riskEdgePrecedence": {
          "type": "boolean"
        },
        "riskAggregation": {
          "enum": [
            "sum",
            "max",
            "mean"
          ]
        },
        "riskAlpha": {
          "type": "number",
          "minimum": 0
        },
        "hazardBeta": {
          "type": "number",
          "minimum": 0
        },
        "beaconBeta": {
          "type": "number",
          "minimum": 0
        },
        "riskUnitCost": {
          "type": "number",
          "minimum": 0
        },
        "replanPolicy": {
          "enum": [
            "never",
            "blocked_only",
            "on_blocked_or_interval",
            "every_step"
          ]
        },
        "replanIntervalSteps": {
          "type": "integer",
          "minimum": 1
        },
        "noRouteRetryIntervalSteps": {
          "type": "integer",
          "minimum": 1
        },
        "routeRecommendation": {
          "$ref": "#/$defs/RouteRecommendation"
        }
      }
    },
    "Outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputFolder": {
          "type": "string"
        },
        "saveRoutes": {
          "type": "boolean"
        },
        "saveMetrics": {
          "type": "boolean"
        },
        "saveTimeSeries": {
          "type": "boolean"
        },
        "saveEvents": {
          "type": "boolean"
        },
        "saveTrajectories": {
          "type": "boolean"
        }
      }
    },
    "Activation": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "initial",
            "scheduled",
            "external_service"
          ]
        },
        "startStep": {
          "type": "integer",
          "minimum": 0
        },
        "startTimeS": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "GrowthModel": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "static",
            "linear_radius",
            "external_field",
            "custom"
          ]
        },
        "initialRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "radiusPerStep": {
          "type": "number"
        },
        "maxRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "Influence": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "radius",
            "polygon",
            "graph_refs",
            "custom"
          ]
        },
        "radiusM": {
          "type": "number",
          "minimum": 0
        },
        "innerRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "area": {
          "$ref": "#/$defs/Polygon"
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "Effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "riskPenalty": {
          "type": "number",
          "minimum": 0
        },
        "speedFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "visibilityFactor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "capacityFactor": {
          "type": "number",
          "minimum": 0
        },
        "blockRouting": {
          "type": "boolean"
        },
        "guidanceBias": {
          "type": "number"
        }
      }
    },
    "Affects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cellSpaceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "cellBoundaryRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "nodeRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "edgeRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "layerRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "EntityRef": {
      "type": "object",
      "required": [
        "entityType",
        "entityId"
      ],
      "additionalProperties": false,
      "properties": {
        "entityType": {
          "enum": [
            "level",
            "cell_space",
            "cell_boundary",
            "node",
            "edge",
            "source_feature"
          ]
        },
        "entityId": {
          "type": "string"
        }
      }
    },
    "ScenarioDataModelInfo": {
      "type": "object",
      "required": [
        "modelName",
        "modelVersion",
        "profile"
      ],
      "additionalProperties": false,
      "properties": {
        "modelName": {
          "const": "indoor_data_model"
        },
        "modelVersion": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        }
      }
    },
    "Point": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "Polygon": {
      "type": "object",
      "required": [
        "type",
        "coordinates"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}
